{
  "name": "@dynamicforms/vuetify-inputs",
  "private": false,
  "version": "0.9.2",
  "type": "module",
  "description": "Vuetify input components with guaranteed visual consistency across all form fields — unified density/variant system, globally configurable, with inline mode for table cells. Built for @dynamicforms/vue-forms.",
  "author": "Jure Erznožnik",
  "files": [
    "dist/*"
  ],
  "main": "dist/dynamicforms-vuetify-inputs.umd.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/dynamicforms-vuetify-inputs.umd.cjs",
      "import": "./dist/dynamicforms-vuetify-inputs.js"
    },
    "./styles.css": "./dist/dynamicforms-vuetify-inputs.css"
  },
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "lint": "eslint src --fix && vue-tsc --noEmit",
    "lint:ci": "eslint src && vue-tsc --noEmit",
    "docs:dev": "npm run docs:dev -w docs",
    "docs:build": "npm run docs:build -w docs",
    "docs:preview": "npm run docs:preview -w docs"
  },
  "keywords": [
    "vue",
    "vuetify",
    "dynamicforms",
    "velis",
    "forms",
    "inputs",
    "components",
    "data entry",
    "typescript",
    "material-design"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://docs.velis.si/dynamicforms/vuetify-inputs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynamicforms/vuetify-inputs.git"
  },
  "bugs": {
    "url": "https://github.com/dynamicforms/vuetify-inputs/issues"
  },
  "peerDependencies": {
    "@ckeditor/ckeditor5-vue": "^7.0.0",
    "@dynamicforms/vue-forms": "^0.17.0",
    "@mdi/font": "^7.4.47",
    "ckeditor5": "^43.0.0",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.12",
    "vitepress-plugin-crosslinks": "^1.0.0",
    "vue": "^3.5.2",
    "vue-cached-icon": "^3.0.3",
    "vue-markdown-render": "^2.2.1",
    "vuetify": "^3.9"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/markdown-it-attrs": "^4.1.3",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6",
    "@vitest/coverage-v8": "^3",
    "@vue/test-utils": "^2.2.4",
    "@vue/tsconfig": "^0.7.0",
    "eslint-config-velis": "^2.0.12",
    "jsdom": "^26.0.0",
    "markdown-it-attrs": "^4.3.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-dts": "^4",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^3",
    "vue-tsc": "^2"
  }
}
